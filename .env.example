# Copy this file to .env and fill in the values. Never commit .env.

# ---------- Phase 1: voice ----------
# Exotel dashboard → Settings → API
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
# Your ExoPhone (the number customers see)
EXOTEL_CALLER_ID=

# dashboard.sarvam.ai → API keys
SARVAM_API_KEY=

# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Public URL Exotel can reach (e.g. an ngrok URL while testing on your laptop)
PUBLIC_BASE_URL=

# ---------- Phase 2: orders, queue, database ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token (sbp_...) — only for setup scripts, never used by the running app
SUPABASE_ACCESS_TOKEN=
REDIS_URL=redis://localhost:6379/0
# How many calls may run at the same time (raise when the Exotel plan allows)
MAX_CONCURRENT_CALLS=5

# ---------- Phase 4: payments ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
